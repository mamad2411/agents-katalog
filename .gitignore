# === Katalog skill: JANGAN di-ignore lagi (2026-10-08, permintaan user) ===
# skills-expanded/, repo-refs/, skills-index.db, SKILLS-*.md SEMUA ikut git
# supaya ekstrak/clone katalog 100k lengkap. (Sebelumnya di-ignore → cuma 3.500
# skill yang kebawa.) Repo ini lokal tanpa remote — aman.

# === Lock & state runtime ===
*.lock
.gc-state.json

# === Backup (sudah punya git sebagai versioning) ===
*.bak-*
*.bak
README.md.bak-*

# === OS noise ===
.DS_Store
**/.DS_Store
.metadata_never_index
.noindex
.volofficii

# === Python cache ===
__pycache__/
*.pyc

# === Payload scraping besar (STYLE-*.md ratusan KB tiap file) ===
STYLE-*.md

# === Zip besar di folder ini (kalau ada) ===
*.zip

# === Backup migration (jangan masuk git) ===
backup-skills-migrate-*.tar.gz

# === Aset berat di dalam skill (jangan masuk git) ===
skills-store/**/fonts/
skills-store/**/node_modules/
skills-store/**/vendor/
skills-store/**/images/
skills-store/**/*.png
skills-store/**/*.jpg
skills-store/**/*.pdf
skills-store/**/*.zip
skills-store/**/*.mp4
skills-store/**/*.min.js
